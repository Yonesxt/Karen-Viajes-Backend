# ── Base de datos ───────────────────────────────────────────────
# PostgreSQL. En proveedores como Neon/Supabase/Railway agregá ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viajes_con_karen

# ── Sesión del panel ────────────────────────────────────────────
# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres, aleatorio.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_DAYS=7

# ── CORS / cookies ──────────────────────────────────────────────
# Orígenes (separados por coma) desde donde se usa el front. Sin barra final.
ALLOWED_ORIGINS=http://localhost:5173
# 'lax' si el front y la API comparten dominio (ej. app.midominio.com y api.midominio.com).
# 'none' si están en dominios distintos (exige HTTPS).
COOKIE_SAMESITE=lax
# Dominio compartido de la cookie (opcional). Ej: .midominio.com
COOKIE_DOMAIN=
# Si la API corre detrás de un proxy/CDN que informa la IP real en x-forwarded-for (Vercel, Nginx...)
TRUST_PROXY=true

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=viajes-con-karen
# true = al sacar una imagen de un destino (o borrar el destino) también se borra de Cloudinary
CLOUDINARY_DELETE_ORPHANS=false

# ── Usuario administrador inicial (lo usa `npm run admin:create` si no pasás argumentos) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
